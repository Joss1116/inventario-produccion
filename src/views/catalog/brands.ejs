<%- include('../partials/header') %>
<h1>Marcas</h1>
<form method="post" action="/catalogo/marcas" class="card inline">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="field" style="flex:1"><label>Nueva marca</label><input name="name" required></div>
  <button class="btn">Agregar</button>
</form>
<% rows.forEach(b => { %><form id="bf<%= b.id %>" method="post" action="/catalogo/marcas"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= b.id %>"></form><% }) %>
<div class="tablewrap"><table>
  <tr><th>Marca</th><th class="r">Productos</th><th>Activa</th><th></th></tr>
  <% rows.forEach(b => { const f = 'bf' + b.id; %>
  <tr><td><input form="<%= f %>" name="name" value="<%= b.name %>"></td><td class="r"><%= b.products %></td>
    <td><input form="<%= f %>" type="checkbox" name="active" style="width:auto" <%= b.active?'checked':'' %>></td>
    <td><button form="<%= f %>" class="btn sm ghost">Guardar</button></td></tr>
  <% }) %>
  <% if (!rows.length) { %><tr><td colspan="4" class="muted">Aún no hay marcas. También se crean al registrar un producto preparado.</td></tr><% } %>
</table></div>
<%- include('../partials/footer') %>
