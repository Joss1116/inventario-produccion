<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> · Inventario de Producción</title>
<link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
<% if (user) { const on = (p) => (path === p || path.startsWith(p + '/')) ? 'on' : ''; const isAdmin = user.role === 'admin'; %>
<div class="shell">
<nav class="side">
  <div class="brand">Inventario de Producción<small><%= process.env.COMPANY_NAME || 'Planta' %></small></div>
  <a class="<%= path === '/' ? 'on' : '' %>" href="/">Panel</a>

  <h6>Proceso</h6>
  <% if (can('recepcion')) { %><a class="<%= on('/recepcion') %>" href="/recepcion">1 · Recepción</a><% } %>
  <a class="<%= on('/preparacion') %>" href="/preparacion">2 · Preparación</a>
  <a class="<%= on('/envasado') %>" href="/envasado">3 · Envasado</a>
  <a class="<%= on('/inventario') %>" href="/inventario">Inventario</a>

  <% if (can('items.MP') || can('items.ENV') || can('items.PP') || can('formulas') || can('marcas') || isAdmin) { %>
  <h6>Catálogo</h6>
  <% if (can('items.MP') || can('items.ENV') || can('items.PP')) { %><a class="<%= on('/catalogo/articulos') %>" href="/catalogo/articulos">Artículos</a><% } %>
  <% if (can('marcas')) { %><a class="<%= on('/catalogo/marcas') %>" href="/catalogo/marcas">Marcas</a><% } %>
  <% if (can('formulas') || can('preparacion')) { %><a class="<%= on('/catalogo/formulas') %>" href="/catalogo/formulas">Fórmulas</a><% } %>
  <% if (isAdmin) { %><a class="<%= on('/catalogo/presentaciones') %>" href="/catalogo/presentaciones">Productos terminados</a><% } %>
  <% } %>

  <% if (isAdmin) { %>
  <h6>Administración</h6>
  <a class="<%= on('/admin/salidas') %>" href="/admin/salidas">Salidas / despachos</a>
  <a class="<%= on('/admin/ajustes') %>" href="/admin/ajustes">Conteo físico</a>
  <a class="<%= on('/admin/reportes') %>" href="/admin/reportes">Reportes</a>
  <a class="<%= on('/admin/usuarios') %>" href="/admin/usuarios">Usuarios</a>
  <% } %>
  <div class="who"><%= user.full_name %> · <span class="muted"><%= ROLES[user.role] %></span>
    <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Cerrar sesión</button></form>
  </div>
</nav>
<main>
<% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %>
<% } else { %><main><% } %>
