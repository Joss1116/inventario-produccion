<%- include('partials/header') %>
<h1>Registrar producción (envasado)</h1>

<form method="get" class="card inline noprint">
  <div class="field" style="flex:1;min-width:260px"><label>Producto terminado</label>
    <select name="product" data-autosubmit required>
      <option value="">— Selecciona —</option>
      <% products.forEach(p => { %><option value="<%= p.id %>" <%= product && product.id===p.id ? 'selected':'' %> <%= p.lines ? '' : 'disabled' %>><%= p.code %> · <%= p.name %><%= p.lines ? '' : ' (sin fórmula)' %></option><% }) %>
    </select></div>
  <noscript><button class="btn ghost">Cargar</button></noscript>
</form>

<% if (product) { %>
<form method="post" action="/produccion" id="prodForm">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="productId" value="<%= product.id %>">
  <div class="card">
    <div class="grid g4">
      <div class="field"><label>Fecha de elaboración = Lote</label><input type="date" name="elaborationDate" id="elab" value="<%= form.elaborationDate || today() %>" required>
        <div class="small muted">Lote: <b id="lotPreview"></b></div></div>
      <div class="field"><label>Fecha de envasado</label><input type="date" name="date" value="<%= form.date || today() %>" required></div>
      <div class="field"><label>Turno</label><select name="shift"><% ['Mañana','Tarde','Noche'].forEach(s => { %><option <%= form.shift===s?'selected':'' %>><%= s %></option><% }) %></select></div>
      <div class="field"><label>Línea / máquina</label><input name="line" value="<%= form.line || '' %>" placeholder="Ej. Línea 1"></div>
      <div class="field"><label>Unidades buenas envasadas (<%= product.unit %>)</label><input type="number" step="any" min="0" name="qtyGood" id="qtyGood" value="<%= form.qtyGood || '' %>" required autofocus></div>
      <div class="field"><label>Unidades rechazadas / defectuosas</label><input type="number" step="any" min="0" name="qtyRejected" id="qtyRejected" value="<%= form.qtyRejected || 0 %>"></div>
      <div class="field"><label>Capacidad con stock actual</label><div class="kpi"><div class="v"><%= n(cap.max, 0) %></div><div class="l"><%= cap.bottleneck ? 'Limita: ' + cap.bottleneck.name : '' %></div></div></div>
    </div>
  </div>

  <h2>Consumo de materiales</h2>
  <p class="muted small">El consumo teórico se calcula con la fórmula (incluye merma estándar). Si lo usado en planta fue distinto, corrige la columna <b>Real</b>. Desviaciones mayores a <%= tolerance %>% exigen observación.</p>
  <div class="tablewrap"><table class="lines">
    <tr><th>Componente</th><th class="r">Por unidad</th><th class="r">Disponible</th><th class="r">Teórico</th><th class="r" style="width:150px">Real usado</th><th class="r">Desv.</th></tr>
    <% recipe.forEach((r, i) => { const prev = [].concat(form.actualQty || [])[i]; %>
    <tr data-qpu="<%= r.qty_per_unit %>" data-waste="<%= r.waste_pct %>" data-stock="<%= r.stock %>">
      <td><span class="chip <%= r.type %>"><%= r.type %></span> <%= r.name %> <span class="muted small"><%= r.code %></span>
        <input type="hidden" name="componentId" value="<%= r.component_id %>"></td>
      <td class="r"><%= n(r.qty_per_unit, 6) %> <%= r.unit %><% if (r.waste_pct) { %><br><span class="muted small">+<%= n(r.waste_pct) %>% merma</span><% } %></td>
      <td class="r stock"><%= n(r.stock, 4) %> <%= r.unit %></td>
      <td class="r theo">0</td>
      <td class="r"><input type="number" step="any" min="0" name="actualQty" class="actual" value="<%= prev || '' %>" <%= prev ? 'data-touched=1' : '' %>></td>
      <td class="r var">—</td>
    </tr>
    <% }) %>
  </table></div>

  <div class="card">
    <div class="field"><label>Observaciones</label><textarea name="notes" placeholder="Incidencias, paradas, motivo de desviación o rechazo…"><%= form.notes || '' %></textarea></div>
    <div id="warn" class="flash error" style="display:none"></div>
    <button class="btn">Registrar producción</button>
  </div>
</form>
<script type="application/json" id="cfg"><%- JSON.stringify({ tolerance }) %></script>
<script src="/static/js/production.js"></script>
<% } %>
<%- include('partials/footer') %>
