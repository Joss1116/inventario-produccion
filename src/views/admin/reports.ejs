<%- include('../partials/header') %>
<h1>Reportes de producción</h1>
<form class="card inline noprint" method="get">
  <div class="field"><label>Desde</label><input type="date" name="from" value="<%= from %>"></div>
  <div class="field"><label>Hasta</label><input type="date" name="to" value="<%= to %>"></div>
  <button class="btn ghost">Actualizar</button>
  <a class="btn ghost" href="?from=<%= from %>&to=<%= to %>&csv=consumo">CSV consumo</a>
  <a class="btn ghost" href="/preparacion?from=<%= from %>&to=<%= to %>&csv=1">CSV preparaciones</a>
  <a class="btn ghost" href="/envasado?from=<%= from %>&to=<%= to %>&csv=1">CSV envasados</a>
</form>

<h2>Preparación: rendimiento por producto</h2>
<div class="tablewrap"><table>
  <tr><th>Producto preparado</th><th>Marca</th><th class="r">Lotes</th><th class="r">Planificado</th><th class="r">Obtenido</th><th class="r">Rendimiento</th><th class="r">Costo / unidad</th></tr>
  <% preps.forEach(r => { const y = r.planned ? r.obtained/r.planned*100 : 0; %>
  <tr><td><%= r.code %> · <%= r.name %></td><td><%= r.brand || '' %></td><td class="r"><%= r.batches %></td><td class="r"><%= n(r.planned) %> <%= r.unit %></td><td class="r"><%= n(r.obtained) %></td>
    <td class="r <%= Math.abs(y-100) > tolerance ? 'neg' : '' %>"><%= n(y,1) %>%</td><td class="r"><%= r.obtained ? money(r.cost/r.obtained) : '—' %></td></tr>
  <% }) %>
  <% if (!preps.length) { %><tr><td colspan="7" class="muted">Sin preparaciones en el periodo.</td></tr><% } %>
</table></div>

<h2>Envasado: unidades y rechazo por producto</h2>
<div class="tablewrap"><table>
  <tr><th>Producto terminado</th><th class="r">Envasados</th><th class="r">Buenas</th><th class="r">Rechazadas</th><th class="r">% rechazo</th><th class="r">Costo total</th><th class="r">Costo / unidad</th></tr>
  <% packs.forEach(r => { const pr = r.rejected/(r.good+r.rejected)*100; %>
  <tr><td><%= r.code %> · <%= r.name %></td><td class="r"><%= r.batches %></td><td class="r"><%= n(r.good) %></td><td class="r"><%= n(r.rejected) %></td>
    <td class="r <%= pr > 2 ? 'neg' : '' %>"><%= n(pr,2) %>%</td><td class="r"><%= money(r.cost) %></td><td class="r"><%= r.good ? money(r.cost/r.good) : '—' %></td></tr>
  <% }) %>
  <% if (!packs.length) { %><tr><td colspan="7" class="muted">Sin envasados en el periodo.</td></tr><% } %>
</table></div>

<h2>Consumo real vs. teórico</h2>
<p class="small muted">Desviación positiva = se usó más de lo esperado (pérdida). Fuera de ±<%= tolerance %>% en rojo.</p>
<div class="tablewrap"><table>
  <tr><th>Etapa</th><th>Componente</th><th class="r">Teórico</th><th class="r">Real</th><th class="r">Desviación</th><th class="r">%</th><th class="r">Costo</th></tr>
  <% byComponent.forEach(r => { const dv = r.actual - r.theo; const pc = r.theo ? dv/r.theo*100 : 0; %>
  <tr><td class="small"><%= r.kind === 'PREPARACION' ? 'Preparación' : 'Envasado' %></td><td><span class="chip <%= r.type %>"><%= r.type %></span> <%= r.name %></td><td class="r"><%= n(r.theo,4) %> <%= r.unit %></td><td class="r"><%= n(r.actual,4) %></td>
    <td class="r"><%= dv>0?'+':'' %><%= n(dv,4) %></td><td class="r <%= Math.abs(pc)>tolerance?'neg':'muted' %>"><%= pc>0?'+':'' %><%= pc.toFixed(2) %>%</td><td class="r"><%= money(r.cost) %></td></tr>
  <% }) %>
</table></div>
<%- include('../partials/footer') %>
