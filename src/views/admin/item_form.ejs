<%- include('../partials/header') %>
<h1><%= title %></h1>
<form method="post" action="/admin/articulos" class="card" style="max-width:720px">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (item.id) { %><input type="hidden" name="id" value="<%= item.id %>"><% } %>
  <div class="grid g2">
    <div class="field"><label>Código</label><input name="code" value="<%= item.code||'' %>" required placeholder="MP-001"></div>
    <div class="field"><label>Tipo</label><select name="type">
      <% Object.entries(TYPES).forEach(([k,v]) => { %><option value="<%= k %>" <%= item.type===k?'selected':'' %>><%= v %></option><% }) %></select></div>
    <div class="field" style="grid-column:1/-1"><label>Nombre</label><input name="name" value="<%= item.name||'' %>" required></div>
    <div class="field"><label>Unidad de medida</label><input name="unit" value="<%= item.unit||'' %>" list="units" required placeholder="kg, L, und…">
      <datalist id="units"><option>kg</option><option>g</option><option>L</option><option>ml</option><option>und</option><option>caja</option><option>m</option></datalist></div>
    <div class="field"><label>Stock mínimo (alerta de reposición)</label><input type="number" step="any" min="0" name="min_stock" value="<%= item.min_stock||0 %>"></div>
    <div class="field" style="grid-column:1/-1"><label>Notas / especificación</label><textarea name="notes"><%= item.notes||'' %></textarea></div>
    <% if (item.id) { %><div class="field"><label><input type="checkbox" name="active" style="width:auto" <%= item.active?'checked':'' %>> Activo</label></div><% } %>
  </div>
  <p class="small muted">Usa siempre la misma unidad base: las fórmulas, compras y consumos se expresan en ella.</p>
  <button class="btn">Guardar</button> <a class="btn ghost" href="/admin/articulos">Cancelar</a>
</form>
<%- include('../partials/footer') %>
