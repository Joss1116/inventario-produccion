<%- include('../partials/header') %>
<h1>Registrar compra / entrada de materiales</h1>
<form method="post" action="/admin/compras">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="card"><div class="grid g4">
    <div class="field"><label>Fecha</label><input type="date" name="date" value="<%= form.date || today() %>" required></div>
    <div class="field"><label>Factura / conduce</label><input name="docNumber" value="<%= form.docNumber || '' %>"></div>
    <div class="field"><label>Proveedor</label><input name="supplier" list="sup" value="<%= form.supplier || '' %>">
      <datalist id="sup"><% suppliers.forEach(s => { %><option><%= s.name %></option><% }) %></datalist></div>
    <div class="field"><label>&nbsp;</label><label><input type="checkbox" name="initial" style="width:auto" <%= form.initial ? 'checked' : '' %>> Inventario inicial (carga de apertura)</label></div>
  </div></div>

  <div class="tablewrap"><table class="lines">
    <tr><th>Artículo</th><th style="width:130px">Cantidad</th><th style="width:140px">Costo unitario RD$</th><th style="width:150px">Lote proveedor</th><th style="width:150px">Vence</th></tr>
    <tbody id="plines">
    <% for (let k = 0; k < 6; k++) { %>
    <tr>
      <td><select name="itemId"><option value="">—</option>
        <% items.forEach(i => { %><option value="<%= i.id %>">[<%= i.type %>] <%= i.code %> · <%= i.name %> (<%= i.unit %>)</option><% }) %></select></td>
      <td><input type="number" step="any" min="0" name="qty"></td>
      <td><input type="number" step="any" min="0" name="unitCost"></td>
      <td><input name="lotCode" placeholder="opcional"></td>
      <td><input type="date" name="expiry"></td>
    </tr>
    <% } %>
    </tbody>
  </table></div>
  <button type="button" class="btn ghost sm" data-addrow="plines">+ Agregar línea</button>
  <div class="card" style="margin-top:14px">
    <div class="field"><label>Notas</label><textarea name="notes"><%= form.notes || '' %></textarea></div>
    <button class="btn">Registrar entrada</button>
  </div>
</form>
<%- include('../partials/footer') %>
