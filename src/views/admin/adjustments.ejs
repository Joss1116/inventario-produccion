<%- include('../partials/header') %>
<h1>Ajustes por conteo físico</h1>
<form method="post" action="/admin/ajustes" class="card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="grid g4">
    <div class="field" style="grid-column:span 2"><label>Artículo</label><select name="itemId" required><option value="">—</option>
      <% items.forEach(i => { %><option value="<%= i.id %>">[<%= i.type %>] <%= i.name %> — sistema: <%= n(i.stock,4) %> <%= i.unit %></option><% }) %></select></div>
    <div class="field"><label>Cantidad contada físicamente</label><input type="number" step="any" min="0" name="countedQty" required></div>
    <div class="field"><label>Motivo</label><input name="reason" required placeholder="Conteo mensual, derrame, vencido…"></div>
  </div>
  <p class="small muted">El sistema calcula la diferencia contra el saldo teórico y genera el movimiento de ajuste (positivo o negativo). Queda registrado en el kardex.</p>
  <button class="btn">Aplicar ajuste</button>
</form>
<div class="tablewrap"><table>
  <tr><th>Fecha</th><th>Artículo</th><th class="r">Sistema</th><th class="r">Contado</th><th class="r">Diferencia</th><th>Motivo</th><th>Registró</th></tr>
  <% rows.forEach(r => { const df = r.counted_qty - r.system_qty; %><tr><td class="small"><%= d(r.created_at) %></td><td><a href="/inventario/<%= r.item_id %>"><%= r.name %></a></td>
    <td class="r"><%= n(r.system_qty,4) %></td><td class="r"><%= n(r.counted_qty,4) %></td>
    <td class="r <%= df<0?'neg':'pos' %>"><%= df>0?'+':'' %><%= n(df,4) %> <%= r.unit %></td><td><%= r.reason %></td><td><%= r.by_name %></td></tr><% }) %>
</table></div>
<%- include('../partials/footer') %>
