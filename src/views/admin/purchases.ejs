<%- include('../partials/header') %>
<div class="bar"><h1 class="grow">Compras y entradas</h1><a class="btn" href="/admin/compras/nueva">+ Registrar entrada</a></div>
<div class="tablewrap"><table>
  <tr><th>#</th><th>Fecha</th><th>Documento</th><th>Proveedor</th><th class="r">Líneas</th><th class="r">Total</th><th>Registró</th><th>Estado</th></tr>
  <% rows.forEach(p => { %>
  <tr class="<%= p.status==='anulada'?'off':'' %>"><td><a href="/admin/compras/<%= p.id %>"><%= p.id %></a></td><td><%= p.purchase_date %></td>
    <td><%= p.doc_number || '' %> <% if (p.is_initial) { %><span class="chip">inicial</span><% } %></td><td><%= p.supplier || '' %></td>
    <td class="r"><%= p.lines %></td><td class="r"><%= money(p.total) %></td><td><%= p.by_name %></td>
    <td><span class="chip <%= p.status==='anulada'?'bad':'ok' %>"><%= p.status %></span></td></tr>
  <% }) %>
  <% if (!rows.length) { %><tr><td colspan="8" class="muted">Aún no hay entradas.</td></tr><% } %>
</table></div>
<%- include('../partials/footer') %>
