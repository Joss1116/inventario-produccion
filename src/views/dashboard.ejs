<%- include('partials/header') %>
<div class="bar"><h1 class="grow">Panel</h1>
  <% if (can('recepcion')) { %><a class="btn ghost" href="/recepcion/nueva">+ Recepción</a><% } %>
  <% if (can('preparacion')) { %><a class="btn ghost" href="/preparacion/nueva">+ Preparación</a><% } %>
  <% if (can('envasado')) { %><a class="btn" href="/envasado/nuevo">+ Envasado</a><% } %>
</div>

<div class="flow card small">
  <span><b>1 · Recepción</b><br>materia prima y envases</span><span class="arrow">→</span>
  <span><b>2 · Preparación</b><br>el químico prepara el producto y nace el lote</span><span class="arrow">→</span>
  <span><b>3 · Envasado</b><br>lote preparado + envases = producto terminado</span>
</div>

<div class="grid g4">
  <div class="card kpi"><div class="v"><%= kpi.today_preps %></div><div class="l">Preparaciones hoy</div></div>
  <div class="card kpi"><div class="v"><%= n(kpi.today_units, 0) %></div><div class="l">Unidades envasadas hoy</div></div>
  <div class="card kpi"><div class="v"><%= n(kpi.month_units, 0) %></div><div class="l">Unidades envasadas en el mes</div></div>
  <div class="card kpi"><div class="v"><%= money(kpi.mp_value) %></div><div class="l">Valor MP + envases</div></div>
</div>

<h2>Producto preparado listo para envasar</h2>
<div class="tablewrap"><table>
  <tr><th>Lote</th><th>Producto</th><th>Marca</th><th class="r">Disponible</th></tr>
  <% bulkLots.forEach(l => { %>
  <tr><td><b><%= l.lot_code %></b></td><td><a href="/inventario/<%= l.item_id %>"><%= l.name %></a></td><td><%= l.brand || '' %></td><td class="r"><%= n(l.qty, 4) %> <%= l.unit %></td></tr>
  <% }) %>
  <% if (!bulkLots.length) { %><tr><td colspan="4" class="muted">No hay producto preparado pendiente de envasar.</td></tr><% } %>
</table></div>

<div class="grid g2">
  <div>
    <h2>Bajo stock mínimo <% if (low.length) { %><span class="chip bad"><%= low.length %></span><% } %></h2>
    <div class="tablewrap"><table>
      <tr><th>Artículo</th><th class="r">Stock</th><th class="r">Mínimo</th></tr>
      <% low.forEach(i => { %>
      <tr><td><span class="chip <%= i.type %>"><%= i.type %></span> <a href="/inventario/<%= i.id %>"><%= i.name %></a></td>
        <td class="r neg"><%= n(i.stock) %> <%= i.unit %></td><td class="r"><%= n(i.min_stock) %></td></tr>
      <% }) %>
      <% if (!low.length) { %><tr><td colspan="3" class="muted">Todo por encima del mínimo.</td></tr><% } %>
    </table></div>
  </div>
  <div>
    <h2>Materia prima que vence en 30 días</h2>
    <div class="tablewrap"><table>
      <tr><th>Artículo</th><th>Lote</th><th>Vence</th><th class="r">Saldo</th></tr>
      <% expiring.forEach(l => { %>
      <tr><td><a href="/inventario/<%= l.item_id %>"><%= l.name %></a></td><td><%= l.lot_code %></td>
        <td><span class="chip <%= l.expiry_date < today() ? 'bad' : 'warn' %>"><%= l.expiry_date %></span></td><td class="r"><%= n(l.qty) %> <%= l.unit %></td></tr>
      <% }) %>
      <% if (!expiring.length) { %><tr><td colspan="4" class="muted">Sin vencimientos próximos.</td></tr><% } %>
    </table></div>
  </div>
</div>

<h2>Última actividad</h2>
<div class="tablewrap"><table>
  <tr><th>Etapa</th><th>Lote</th><th>Registro</th><th>Fecha</th><th>Producto</th><th class="r">Cantidad</th><th>Registró</th></tr>
  <% recent.forEach(p => { %>
  <tr class="<%= p.status === 'anulada' ? 'off' : '' %>"><td><span class="chip <%= p.kind === 'PREPARACION' ? 'PP' : 'PT' %>"><%= p.kind === 'PREPARACION' ? 'Preparación' : 'Envasado' %></span></td>
    <td><b><%= p.lot_code %></b></td><td><a href="/produccion/<%= p.id %>"><%= p.code %></a></td><td><%= p.production_date %></td>
    <td><%= p.product %></td><td class="r"><%= n(p.qty_good) %> <%= p.unit %></td><td><%= p.by_name %></td></tr>
  <% }) %>
</table></div>
<%- include('partials/footer') %>
